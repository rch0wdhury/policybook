    {
      "name": "the scaled arithmetic keeps a fraction the textbook form would round",
      "params": {
        "ratePerSec": 3,
        "burst": 2
      },
      "seed": 1,
      "steps": [
        {
          "call": "allow",
          "args": [
            1,
            2,
            0
          ],
