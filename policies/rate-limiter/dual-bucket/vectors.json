        {
          "call": "allow",
          "args": [
            1,
            100,
            0
          ],
          "expect": false
        },
        {
          "call": "requestsOf",
          "args": [
            1,
            0
          ],
          "expect": 0
        },
        {
          "call": "tokensOf",
          "args": [
            1,
            0
          ],
          "expect": 700
