        {
          "call": "allow",
          "args": [
            2,
            1000,
            0
          ],
          "expect": true
        },
        {
          "call": "requestsOf",
          "args": [
            2,
            0
          ],
          "expect": 2
        },
        {
          "call": "tokensOf",
          "args": [
            2,
            0
          ],
          "expect": 0
        },
        {
          "call": "allow",
          "args": [
            2,
            1,
            0
          ],
          "expect": false
        },
        {
          "call": "retryAfter",
          "args": [
            2,
            0
          ],
          "expect": 60
        },
        {
          "call": "tokensOf",
          "args": [
            2,
            60
          ],
          "expect": 1
        },
        {
          "call": "allow",
          "args": [
            2,
            1,
            60
          ],
          "expect": true
        }
      ]
    },
