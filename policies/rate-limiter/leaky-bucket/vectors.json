        {
          "call": "allow",
          "args": [
            1,
            1,
            0
          ],
          "expect": false
        },
        {
          "call": "retryAfter",
          "args": [
            1,
            0
          ],
          "expect": 10
        },
        {
          "call": "allow",
          "args": [
            1,
            1,
            9
          ],
          "expect": false
        },
        {
          "call": "allow",
          "args": [
            1,
            1,
            10
          ],
          "expect": true
        },
        {
          "call": "allow",
          "args": [
            1,
            1,
            10
          ],
          "expect": false
        },
        {
          "call": "allow",
          "args": [
            1,
            1,
            19
          ],
          "expect": false
        },
        {
          "call": "allow",
          "args": [
            1,
            1,
            20
          ],
          "expect": true
        },
        {
          "call": "allow",
          "args": [
            1,
            2,
            10000
          ],
          "expect": false
        },
        {
          "call": "allow",
          "args": [
            1,
            1,
            10000
          ],
          "expect": true
        }
      ]
    },
    {
      "name": "tiebreak: a request filling exactly the remaining room is admitted",
