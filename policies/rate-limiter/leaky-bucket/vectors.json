          "expect": true
        },
        {
          "call": "allow",
          "args": [
            3,
            1,
            0
          ],
          "expect": false
        },
        {
          "call": "allow",
          "args": [
            4,
            6,
            0
          ],
          "expect": false
        },
        {
          "call": "levelOf",
          "args": [
            4,
            0
          ],
          "expect": 0
