    {
      "name": "equivalence: the mirror of the token bucket's own case",
      "params": {
        "ratePerSec": 100,
        "capacity": 5
      },
      "seed": 1,
      "steps": [
        {
          "call": "levelOf",
          "args": [
            7,
            0
          ],
          "expect": 0
        },
        {
          "call": "allow",
          "args": [
            7,
            2,
            0
          ],
          "expect": true
        },
        {
          "call": "levelOf",
          "args": [
            7,
            0
          ],
          "expect": 2
        },
        {
          "call": "allow",
          "args": [
            7,
            3,
            0
          ],
          "expect": true
        },
        {
          "call": "levelOf",
          "args": [
            7,
            0
          ],
          "expect": 5
        },
        {
          "call": "allow",
          "args": [
            7,
            1,
            0
          ],
          "expect": false
