{
  "policy": "kv-cache/snapkv",
  "version": 1,
  "cases": [
    {
      "name": "smoke: with a window longer than the run and no pooling, it sums",
      "params": {
        "budget": 3,
        "recentWindow": 1,
        "obsWindow": 8,
        "poolKernel": 1
      },
      "seed": 1,
      "steps": [
        {
          "call": "onDecodeStep",
          "args": [
            1,
            [
              1
            ]
          ]
        },
        {
          "call": "onDecodeStep",
          "args": [
            2,
            [
              0.25,
              0.75
            ]
          ]
        },
        {
          "call": "onDecodeStep",
          "args": [
            3,
            [
              0.5,
              0.25,
              0.25
            ]
          ]
        },
        {
          "call": "windowScoreOf",
          "args": [
            0
          ],
          "expect": 1.75
        },
        {
          "call": "windowScoreOf",
          "args": [
            1
          ],
          "expect": 1
        },
        {
          "call": "windowScoreOf",
          "args": [
            2
          ],
          "expect": 0.25
        },
        {
          "call": "evict",
          "args": [
            3
          ],
          "expect": [
            2
          ]
        },
        {
          "call": "keptCount",
          "args": [],
          "expect": 3
        }
      ]
    },
